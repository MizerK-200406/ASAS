# NVIDIA NIM API Settings (100% Free)
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_MODEL=deepseek-ai/deepseek-v4.1-flash

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/asas_db
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/asas_test_db
