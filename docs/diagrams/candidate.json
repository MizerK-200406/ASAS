  "cards": [
    {
      "dot": "rose",
      "title": "Bảo mật & Rào chắn (Security Guardrails)",
      "items": [
        "Python Sandbox chạy headless cô lập, ngăn chặn thực thi mã độc",
        "Web Search có rào chắn chỉ dùng kiểm chứng tri thức khi đánh giá",
        "Tuyệt đối không cho phép học sinh dùng tác tử làm proxy tìm kiếm ngoài"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kiến trúc Đa tác tử (Multi-Agent Architecture)",
      "items": [
        "Supervisor làm Facade duy nhất tiếp nhận câu hỏi và định tuyến ngầm",
        "Tutor giải thích chi tiết, gợi ý hướng giải quyết có kiểm chứng",
        "Evaluator chấm điểm khách quan, chỉ ra lỗ hổng tư duy của học sinh",
        "Planner xây dựng lộ trình học tập bám sát hồ sơ năng lực"
      ]
    },
    {
      "dot": "violet",
      "title": "Cơ sở Dữ liệu Phân rã Kép (Dual Database)",
      "items": [
        "data/users.db: Lưu học sinh, hồ sơ năng lực, điểm thi và tiến độ SM-2",
        "data/chats.db: Lưu phiên trò chuyện và tin nhắn tần suất cao",
        "Tối ưu hóa hiệu năng truy vấn I/O và đảm bảo cô lập dữ liệu người dùng"
      ]
    }
  ]
